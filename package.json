{
  "name": "preset-typescript-base",
  "version": "0.0.0",
  "description": "A strict TypeScript base preset for projects managed with pnpm.",
  "keywords": [
    "typescript",
    "pnpm",
    "preset",
    "template"
  ],
  "homepage": "https://github.com/shazhou-ww/preset-typescript-base#readme",
  "bugs": {
    "url": "https://github.com/shazhou-ww/preset-typescript-base/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shazhou-ww/preset-typescript-base.git"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
